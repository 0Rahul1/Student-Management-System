# ==============================================================================
# STUDENT MANAGEMENT SYSTEM - DATABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    powershell: Copy-Item .env.example .env
# 2. Update the connection string below with your MongoDB credentials.
# 3. DO NOT commit the '.env' file containing real passwords to Git!

# ------------------------------------------------------------------------------
# Option A: Local MongoDB Community Server (Default)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017

# ------------------------------------------------------------------------------
# Option B: MongoDB Atlas (Cloud Cluster)
# ------------------------------------------------------------------------------
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
# MONGODB_URI=mongodb+srv://admin:YourSecurePassword123@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
MONGODB_DATABASE=StudentManagementDB
